{
  "nodeModulesDir": "auto",
  "lock": true,
  "tasks": {
    "dev": "deno run -A npm:vite dev",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "sync": "deno run -A npm:@sveltejs/kit@3.1.1 sync",
    "check": "deno run -A npm:svelte-check --tsconfig ./tsconfig.json"
  },
  "imports": {
    "@sveltejs/adapter-static": "npm:@sveltejs/adapter-static@4.0.1",
    "@sveltejs/kit": "npm:@sveltejs/kit@3.1.1",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@7.3.1",
    "svelte": "npm:svelte@5.57.3",
    "svelte-check": "npm:svelte-check@4.7.8",
    "typescript": "npm:typescript@6.0.3",
    "vite": "npm:vite@8.3.6"
  },
  "compilerOptions": {
    "types": ["svelte", "vite/client"]
  }
}
